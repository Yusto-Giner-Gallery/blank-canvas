# Copy to .env.local and fill. Never commit .env.local.

# Supabase (eu-central-1 / Frankfurt)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe (test mode in v1)
VITE_STRIPE_PUBLISHABLE_KEY=

# Server-side / Supabase Edge Function secrets — do NOT prefix with VITE_
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI client (stubbed in v1; repointable to lovable later)
# VITE_AI_PROVIDER is read by src/lib/ai/client.ts on the browser side.
VITE_AI_PROVIDER=stub
# Server-side / edge-function only:
AI_API_KEY=
